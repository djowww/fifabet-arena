FIFABET_HOST=127.0.0.1
FIFABET_PORT=4174
FIFABET_PUBLIC_ORIGIN=https://betfifa.com.br
FIFABET_DATA_DIR=/var/lib/fifago
FIFABET_PAYMENT_MODE=unconfigured
# Enable only after review accounts and private Pix key are configured on the server.
# Package prices are credits:BRL-cents (100=R$10, 250=R$25, 500=R$50, 1000=R$100).
FIFABET_PIX_KEY=
FIFABET_PIX_PACKAGES=100:1000,250:2500,500:5000,1000:10000
FIFABET_TRUST_PROXY_LOOPBACK=1
FIFABET_MAX_EVIDENCE_BYTES=209715200
FIFABET_REVIEWER_IDS=
# Configure only on the server after creating the provider applications.
FIFABET_GOOGLE_CLIENT_ID=
FIFABET_GOOGLE_CLIENT_SECRET=
FIFABET_APPLE_CLIENT_ID=
FIFABET_APPLE_TEAM_ID=
FIFABET_APPLE_KEY_ID=
FIFABET_APPLE_PRIVATE_KEY_FILE=
NODE_OPTIONS=--max-old-space-size=256
